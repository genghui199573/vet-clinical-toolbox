{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vet-clinical-toolbox/drugs.schema.v3.4.json",
  "title": "兽医临床工具箱药物数据库 v3.4",
  "type": "object",
  "required": [
    "schema_version",
    "database_version",
    "last_reviewed",
    "policy",
    "drugs"
  ],
  "properties": {
    "schema_version": {
      "const": "3.4"
    },
    "database_version": {
      "type": "string"
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    },
    "policy": {
      "type": "object",
      "required": [
        "no_guessing",
        "dose_requires_source",
        "off_label_must_be_marked",
        "official_label_is_separate",
        "food_animal_withdrawal_requires_official_source"
      ],
      "properties": {
        "no_guessing": {
          "const": true
        },
        "dose_requires_source": {
          "const": true
        },
        "off_label_must_be_marked": {
          "const": true
        },
        "official_label_is_separate": {
          "const": true
        },
        "food_animal_withdrawal_requires_official_source": {
          "const": true
        }
      }
    },
    "drugs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/drug"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "source_id",
        "title",
        "source_type",
        "accessed"
      ],
      "properties": {
        "source_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "organization": {
          "type": "string"
        },
        "source_type": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "published": {
          "type": "string"
        },
        "accessed": {
          "type": "string",
          "format": "date"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "dose_record": {
      "type": "object",
      "required": [
        "species_group",
        "species",
        "indication",
        "label_status",
        "route",
        "dose",
        "dose_unit",
        "frequency",
        "source_ids"
      ],
      "properties": {
        "species_group": {
          "type": "string",
          "enum": [
            "犬猫",
            "经济动物",
            "马属",
            "鸟类",
            "禽类",
            "爬宠",
            "兔及啮齿类",
            "其他特殊宠物"
          ]
        },
        "species": {
          "type": "string"
        },
        "indication": {
          "type": "string"
        },
        "indication_keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "label_status": {
          "type": "string",
          "enum": [
            "中国兽药标签内",
            "其他国家/地区兽药标签内",
            "人用药兽医标签外",
            "兽医药物标签外",
            "指南/文献参考",
            "证据不足-不得作为确定剂量"
          ]
        },
        "route": {
          "type": "string"
        },
        "dose": {
          "type": [
            "number",
            "null"
          ]
        },
        "dose_unit": {
          "type": "string"
        },
        "dose_basis": {
          "type": [
            "string",
            "null"
          ]
        },
        "frequency": {
          "type": "string"
        },
        "duration": {
          "type": "string"
        },
        "concentration": {
          "type": "string"
        },
        "dose_notes": {
          "type": "string"
        },
        "monitoring": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "drug": {
      "type": "object",
      "required": [
        "id",
        "generic_name_zh",
        "aliases",
        "pharmacologic_class",
        "clinical_categories",
        "dosage_forms",
        "active_ingredient",
        "records"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "generic_name_zh": {
          "type": "string"
        },
        "generic_name_en": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "brand_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "active_ingredient": {
          "type": "string"
        },
        "pharmacologic_class": {
          "type": "string"
        },
        "clinical_categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dosage_forms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "concentrations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mechanism": {
          "type": "string"
        },
        "indications_general": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "indication_keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contraindications": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "adverse_effects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "major_interactions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "special_warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pregnancy_lactation": {
          "type": "string"
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dose_record"
          }
        },
        "food_animal_withdrawal": {
          "type": "object",
          "properties": {
            "meat": {
              "type": "string"
            },
            "milk": {
              "type": "string"
            },
            "eggs": {
              "type": "string"
            },
            "other": {
              "type": "string"
            },
            "source_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "last_verified": {
          "type": "string",
          "format": "date"
        },
        "review_status": {
          "type": "string",
          "enum": [
            "已核验",
            "部分核验",
            "待核验",
            "暂停使用"
          ]
        },
        "species_groups": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "search_terms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}