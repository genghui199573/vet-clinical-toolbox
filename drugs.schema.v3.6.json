{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vet-clinical-toolbox/drugs.schema.v3.6.json",
  "title": "兽医临床工具箱药物数据库 v3.6",
  "type": "object",
  "required": [
    "schema_version",
    "database_version",
    "last_reviewed",
    "policy",
    "drugs"
  ],
  "properties": {
    "schema_version": {
      "const": "3.6"
    },
    "database_version": {
      "type": "string"
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    },
    "policy": {
      "type": "object"
    },
    "drugs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "generic_name_zh",
          "records"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "generic_name_zh": {
            "type": "string"
          },
          "records": {
            "type": "array"
          }
        }
      }
    }
  },
  "additionalProperties": true
}